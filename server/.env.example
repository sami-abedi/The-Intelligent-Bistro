ANTHROPIC_API_KEY=your-key-here
PORT=3000

# Comma-separated list of extra browser origins allowed to call the API.
# The bundled web app is served same-origin and needs no entry here.
# Native mobile requests (no Origin header) are always allowed.
ALLOWED_ORIGINS=

# Sales tax applied to orders (default 8.75%).
TAX_RATE=0.0875

# Secret for the kitchen view (/kitchen.html) and /admin API.
# If unset, the admin API is disabled.
ADMIN_KEY=pick-a-long-random-string
